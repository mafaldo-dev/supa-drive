{
  "expo": {
    "name": "Supa Driver",
    "slug": "supa-drive",
    "version": "1.0.0",
    "scheme": "supa-drive",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d0d14"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0d0d14"
      },
      "package": "com.markondes.supadrive",
      "versionCode": 1,
      "permissions": [
        "NOTIFICATIONS",
        "SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF6B6B"
        }
      ]
    ],
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#FF6B6B"
    },
    "extra": {
      "eas": {
        "projectId": "dffbf326-a416-413d-9a3b-5f06dbdf9d28"
      },
      "BACKEND_URL": "https://backend-supa-drive.onrender.com",
      "WEB_CLIENT_ID": "9376164532-bc5fuh64gsfs6itm3rnhmt81sd9c5dq3.apps.googleusercontent.com"
    },
    "owner": "markondes",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dffbf326-a416-413d-9a3b-5f06dbdf9d28"
    }
  }
}