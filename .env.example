# Copie para .env e preencha os valores locais.
# Nunca versione o .env com valores reais.

# URL do backend
BACKEND_URL=http://localhost:3010

# Google OAuth Web Client ID (valor publico)
WEB_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# Chave publica do Stripe (pk_test_ ou pk_live_, nunca a chave secreta)
STRIPE_PUBLISHABLE_KEY=pk_test_substitua
